{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>DIRACGrid/.github//renovate-config"
  ],
  "packageRules": [
    {
      "description": "Require dashboard approval for Helm chart dependency updates",
      "matchManagers": [
        "helmv3"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group all tool version updates together",
      "matchDatasources": [
        "github-releases"
      ],
      "matchFileNames": [
        "run_demo.sh"
      ],
      "groupName": "demo script tool versions"
    },
    {
      "description": "Pin Helm to 3.x to avoid v4 verification issues",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "helm/helm"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "DiracX and diracx-web releases: bump the chart patch version for a patch release, the minor version otherwise",
      "matchPackageNames": [
        "ghcr.io/diracgrid/diracx/client",
        "ghcr.io/diracgrid/diracx-web/static"
      ],
      "bumpVersions": [
        {
          "name": "diracx chart version",
          "filePatterns": [
            "diracx/Chart.yaml"
          ],
          "matchStrings": [
            "(?:^|\\n)version:\\s*\"?(?<version>[^\"\\s]+)\"?"
          ],
          "bumpType": "{{#if isPatch}}patch{{else}}minor{{/if}}"
        }
      ]
    },
    {
      "description": "Automerge patch releases. Minor/major releases can carry DB migrations or new settings, so they wait for a review",
      "matchPackageNames": [
        "ghcr.io/diracgrid/diracx/client",
        "ghcr.io/diracgrid/diracx-web/static"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "pep440 classes a prerelease-to-final step of the same version (v0.1.0-a11 -> v0.1.0) as patch: treat it as minor",
      "matchPackageNames": [
        "ghcr.io/diracgrid/diracx/client",
        "ghcr.io/diracgrid/diracx-web/static"
      ],
      "matchCurrentValue": "/(a|b|rc)\\d+$/",
      "matchNewValue": "!/(a|b|rc)\\d+$/",
      "automerge": false,
      "bumpVersions": [
        {
          "name": "diracx chart version",
          "filePatterns": [
            "diracx/Chart.yaml"
          ],
          "matchStrings": [
            "(?:^|\\n)version:\\s*\"?(?<version>[^\"\\s]+)\"?"
          ],
          "bumpType": "minor"
        }
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Update tool versions in run_demo.sh",
      "customType": "regex",
      "managerFilePatterns": [
        "/^run_demo\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\n\\s*[A-Z_]+_VERSION=\"(?<currentValue>.*)\"",
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\n\\s*[A-Z_]+_VERSION='(?<currentValue>.*)'"
      ],
      "datasourceTemplate": "{{datasource}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Update the DiracX appVersion and the diracx-web image tag",
      "customType": "regex",
      "managerFilePatterns": [
        "/^diracx/Chart\\.yaml$/",
        "/^diracx/values\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n(?:[ \\t]*# (?:--|@).*\\n)*[ \\t]*(?:appVersion|tag):[ \\t]*\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "{{datasource}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
